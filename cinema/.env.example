# ─────────────────────────────────────────────────────────────────────────────
# Configurazione di CINEMAX
#
# Copiate questo file in `.env.local` e compilate i valori che vi servono.
# Il sito pubblico funziona anche senza nessuna di queste variabili: servono
# per il pannello, l'area personale, l'invio delle email, i pagamenti online e
# lo smaltimento delle notifiche.
# ─────────────────────────────────────────────────────────────────────────────

# Indirizzo pubblico del sito. Determina canonical, sitemap, Open Graph, i
# collegamenti dentro le email e gli indirizzi di ritorno dei pagamenti.
# In mancanza si usa il dominio scritto nelle impostazioni del pannello.
NEXT_PUBLIC_SITO=https://www.cinemax.example

# ── Pannello di amministrazione (/admin) ─────────────────────────────────────
# Obbligatorie in produzione: senza, il pannello risponde che non è configurato
# e l'area personale non emette sessioni valide.
# Per i segreti va bene una stringa casuale lunga, per esempio da:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANNELLO_PASSWORD=
PANNELLO_SEGRETO=

# Password del solo lettore di biglietti, per il tablet all'ingresso della
# sala. Chi accede con questa vede unicamente la verifica dei QR: non la
# programmazione, non l'anagrafica, non gli incassi. Lasciandola vuota il
# livello ristretto non esiste e allo staff serve la password completa.
MASCHERA_PASSWORD=

# Segreto con cui vengono firmati i codici QR dei biglietti.
# Tenetelo separato da PANNELLO_SEGRETO: cambiare la password del pannello non
# deve invalidare i biglietti già venduti per gli spettacoli della settimana.
# Se lo cambiate, tutti i QR emessi in precedenza smettono di essere validi.
BIGLIETTI_SEGRETO=

# ── Archivio dei dati ────────────────────────────────────────────────────────
# Con DATABASE_URL impostata la piattaforma usa PostgreSQL; senza, un file JSON.
#   postgres://utente:password@host:5432/database
# Il pacchetto `pg` è una dipendenza facoltativa: se usate PostgreSQL
# assicuratevi che sia installato (`npm install pg`).
#
# Per più di una sala, o su qualunque piattaforma serverless, usate PostgreSQL:
# il deposito su file presuppone un solo processo con un disco scrivibile.
DATABASE_URL=

# Impostazioni fini della connessione (facoltative).
#   DATABASE_SSL         `1` forza TLS, `0` lo disattiva. In mancanza si decide
#                        dall'host: cifrato ovunque tranne che su localhost.
#   DATABASE_SSL_STRICT  `1` pretende un certificato verificabile. Le
#                        piattaforme gestite spesso non lo permettono.
#   DATABASE_CONNESSIONI numero massimo di connessioni nella riserva (5).
DATABASE_SSL=
DATABASE_SSL_STRICT=
DATABASE_CONNESSIONI=

# Percorso del file JSON usato quando DATABASE_URL è vuota.
# Se non impostato vale `./dati-locali/archivio.json`.
PERCORSO_ARCHIVIO=

# ── Pagamenti online ─────────────────────────────────────────────────────────
# Senza chiavi il pagamento online non viene proposto e la prenotazione si
# conclude con il ritiro in cassa: la piattaforma resta utilizzabile.
#
# I dati delle carte non transitano mai da qui: il cliente li inserisce sulle
# pagine del fornitore e noi riceviamo soltanto l'esito e un identificativo.
STRIPE_SECRET_KEY=

# Segreto del webhook Stripe (whsec_...). Obbligatorio se usate Stripe:
# senza, i riscontri di pagamento vengono rifiutati e nessuna prenotazione
# pagata con carta viene mai confermata. Nel cruscotto Stripe create un
# endpoint verso `/api/pagamento/riscontro` per `checkout.session.completed`.
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# `sandbox` (predefinito) oppure `produzione`
PAYPAL_AMBIENTE=sandbox

# ── Email (facoltative) ──────────────────────────────────────────────────────
# Senza queste variabili gli acquisti funzionano comunque: il biglietto è già
# a schermo e nell'area personale, e in console compare il messaggio che
# sarebbe partito. La chiave si ottiene su https://resend.com
RESEND_API_KEY=
POSTA_MITTENTE="CINEMAX <biglietti@cinemax.example>"
POSTA_STAFF=direzione@cinemax.example

# ── Notifiche programmate ────────────────────────────────────────────────────
# Segreto che protegge `/api/notifiche/coda`, la rotta che spedisce i
# promemoria e le gift card programmate. Va chiamata periodicamente da uno
# schedulatore (Vercel Cron, un servizio di pianificazione, il cron di sistema):
#   curl -X POST -H "Authorization: Bearer <segreto>" https://.../api/notifiche/coda
# Senza segreto la rotta rifiuta ogni chiamata: una rotta che spedisce email e
# che chiunque può invocare è un generatore di posta indesiderata.
NOTIFICHE_SEGRETO=
