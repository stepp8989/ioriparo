# ─────────────────────────────────────────────────────────────────────────────
# Configurazione di Aurora Motori
#
# Copiate questo file in `.env.local` e compilate i valori che vi servono.
# Il sito pubblico funziona anche senza nessuna di queste variabili: servono
# per il pannello, l'area clienti, l'invio delle email, i pagamenti online e
# le statistiche.
# ─────────────────────────────────────────────────────────────────────────────

# Indirizzo pubblico del sito. Determina canonical, sitemap, Open Graph e gli
# indirizzi di ritorno dei pagamenti. In mancanza si usa il dominio scritto in
# `src/dati/azienda.ts`.
NEXT_PUBLIC_SITO=https://www.auroramotori.it

# ── Pannello di amministrazione (/admin) e area clienti ──────────────────────
# Obbligatorie in produzione: senza, il pannello risponde che non è configurato
# e l'area clienti non emette sessioni valide.
# Per il segreto va bene una stringa casuale lunga, per esempio da:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANNELLO_PASSWORD=
PANNELLO_SEGRETO=

# ── Archivio dei dati ────────────────────────────────────────────────────────
# Con DATABASE_URL impostata il sito usa PostgreSQL; senza, un file JSON.
#   postgres://utente:password@host:5432/database
# Il pacchetto `pg` è una dipendenza facoltativa: se usate PostgreSQL
# assicuratevi che sia installato (`npm install pg`).
DATABASE_URL=

# Impostazioni fini della connessione (facoltative).
#   DATABASE_SSL         `1` forza TLS, `0` lo disattiva. In mancanza si decide
#                        dall'host: cifrato ovunque tranne che su localhost.
#   DATABASE_SSL_STRICT  `1` pretende un certificato verificabile. Le
#                        piattaforme gestite spesso non lo permettono.
#   DATABASE_CONNESSIONI numero massimo di connessioni nella riserva (5).
DATABASE_SSL=
DATABASE_SSL_STRICT=
DATABASE_CONNESSIONI=

# Percorso del file JSON usato quando DATABASE_URL è vuota.
# Se non impostato vale `./dati-locali/archivio.json`. Su piattaforme con disco
# di sola lettura le modifiche fatte dal pannello non sopravvivono al riavvio:
# in quel caso usate PostgreSQL.
PERCORSO_ARCHIVIO=

# ── Email (facoltative) ──────────────────────────────────────────────────────
# Senza queste variabili prenotazioni e richieste vengono comunque registrate e
# mostrate nel pannello: cambia solo che l'email di conferma non parte.
# La chiave si ottiene su https://resend.com
RESEND_API_KEY=
POSTA_MITTENTE="Aurora Motori <info@auroramotori.it>"
POSTA_STAFF=vendite@auroramotori.it

# ── SMS (facoltativi) ────────────────────────────────────────────────────────
# Promemoria di ritiro e conferme di appuntamento via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MITTENTE=

# ── Pagamenti online (facoltativi) ───────────────────────────────────────────
# Senza chiavi il metodo online non viene proposto e il noleggio si conclude
# con il pagamento al ritiro.
STRIPE_SECRET_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# `sandbox` (predefinito) oppure `produzione`
PAYPAL_AMBIENTE=sandbox

# ── Statistiche (facoltative) ────────────────────────────────────────────────
# Identificativo di misurazione Google Analytics 4. Lo script viene caricato
# solo dopo il consenso esplicito nel banner cookie.
NEXT_PUBLIC_GA_ID=
