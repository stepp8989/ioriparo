# ─────────────────────────────────────────────────────────────────────────────
# Orbita Studio — configurazione
#
# Il sito funziona senza nessuna di queste variabili: le richieste di preventivo
# vengono comunque registrate e in console si legge il messaggio che sarebbe
# partito. Copiare questo file in `.env.local` e riempire solo ciò che serve.
# ─────────────────────────────────────────────────────────────────────────────

# Dominio pubblico. Usato per canonical, sitemap, Open Graph e dati strutturati.
# Senza, il sito usa l'indirizzo scritto in `src/dati/agenzia.ts`.
NEXT_PUBLIC_SITO=https://www.orbitastudio.it

# ── Posta ────────────────────────────────────────────────────────────────────
# Invio delle notifiche di nuova richiesta tramite l'API HTTP di Resend
# (https://resend.com). Senza chiave l'invio è disattivato e la richiesta resta
# solo nell'archivio.
RESEND_API_KEY=
# Mittente verificato presso il servizio, es. "Orbita Studio <ciao@dominio.it>"
POSTA_MITTENTE=
# Destinatario delle notifiche. Senza, si usa l'email in `src/dati/agenzia.ts`.
POSTA_DESTINATARIO=

# ── Archivio delle richieste ─────────────────────────────────────────────────
# File in cui vengono registrate le richieste di preventivo, una per riga.
# Dove il disco non è scrivibile (funzioni serverless) le richieste restano in
# memoria per la durata dell'istanza e la notifica per email diventa l'unico
# recapito affidabile: in quel caso configurare Resend.
PERCORSO_RICHIESTE=./dati-locali/richieste.jsonl
