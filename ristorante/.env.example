# ─────────────────────────────────────────────────────────────────────────────
# Configurazione di Ristorante Aurea
#
# Copiate questo file in `.env.local` e compilate i valori che vi servono.
# Il sito pubblico funziona anche senza nessuna di queste variabili: servono
# per il pannello di amministrazione, per l'invio delle email e per le
# statistiche.
# ─────────────────────────────────────────────────────────────────────────────

# Indirizzo pubblico del sito. Determina canonical, sitemap e Open Graph.
# In mancanza si usa il dominio scritto in `src/dati/ristorante.ts`.
NEXT_PUBLIC_SITO=https://www.ristoranteaurea.it

# ── Pannello di amministrazione (/admin) ─────────────────────────────────────
# Obbligatorie in produzione: senza, il pannello risponde che non è configurato.
# Per il segreto va bene una stringa casuale lunga, per esempio da:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANNELLO_PASSWORD=
PANNELLO_SEGRETO=

# ── Email di conferma (facoltative) ──────────────────────────────────────────
# Senza queste variabili le prenotazioni vengono comunque registrate e mostrate
# nel pannello: cambia solo che l'email di conferma non parte.
# La chiave si ottiene su https://resend.com
RESEND_API_KEY=
POSTA_MITTENTE="Ristorante Aurea <prenotazioni@ristoranteaurea.it>"

# ── Statistiche (facoltative) ────────────────────────────────────────────────
# Identificativo di misurazione Google Analytics 4. Lo script viene caricato
# solo dopo il consenso esplicito nel banner cookie.
NEXT_PUBLIC_GA_ID=

# ── Archivio dei contenuti (facoltativo) ─────────────────────────────────────
# Percorso del file JSON con menù, prenotazioni, recensioni, orari ed eventi.
# Se non impostato vale `./dati-locali/archivio.json`. Su piattaforme con disco
# di sola lettura indicate un volume scrivibile, altrimenti le modifiche fatte
# dal pannello non sopravvivono al riavvio.
PERCORSO_ARCHIVIO=
